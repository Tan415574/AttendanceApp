@using Microsoft.AspNetCore.Identity
@using AttendanceApp.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AttendanceApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @{
        bool IsActive(string prefix) => Context.Request.Path.StartsWithSegments(prefix);
        bool hideTopbar = ViewData.ContainsKey("HideTopbar");
    }
    @if (!hideTopbar)
    {
        <header class="topbar">
            <a class="brand" href="/">AttendanceApp</a>
            <nav>
                @if (SignInManager.IsSignedIn(User))
                {
                    <span class="nav-pill">
                        @if (User.IsInRole("Lecturer"))
                        {
                            <a class="@(IsActive("/Lecturer/Meetings") ? "active" : "")" href="/Lecturer/Meetings/Index">My meetings</a>
                            <a class="@(IsActive("/Lecturer/Overview") ? "active" : "")" href="/Lecturer/Overview">Overview</a>
                            <a class="@(IsActive("/Lecturer/Queries") ? "active" : "")" href="/Lecturer/Queries">Queries</a>
                        }
                        else
                        {
                            <a class="@(IsActive("/Student/CheckIn") ? "active" : "")" href="/Student/CheckIn">Check in</a>
                            <a class="@(IsActive("/Student/Attendance") || IsActive("/Student/Query") ? "active" : "")" href="/Student/Attendance">My attendance</a>
                        }
                    </span>
                    <form method="post" asp-page="/Account/Logout" class="inline-form">
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login">Sign in</a>
                    <a href="/Account/Register">Sign up</a>
                }
            </nav>
        </header>
    }

    <main class="@(hideTopbar ? "page-full" : "page")">
        @RenderBody()
    </main>
</body>
</html>
