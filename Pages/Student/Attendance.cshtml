@page
@model AttendanceApp.Pages.Student.AttendanceModel
@{ ViewData["Title"] = "My attendance"; }

@{
    var diff = Model.MyOverallPercent - Model.ClassAveragePercent;
    var isAbove = diff >= 0;
}

@if (Model.SessionsHeldAllTime > 0)
{
    <div class="card">
        <h2 style="margin-top:0;">You vs. the class</h2>
        <div style="display:flex;gap:28px;align-items:baseline;flex-wrap:wrap;margin-bottom:16px;">
            <div>
                <div style="font-family:var(--font-display);font-size:2rem;font-weight:800;">@Model.MyOverallPercent.ToString("0.#")%</div>
                <div style="color:var(--muted);font-size:0.85rem;">Your overall attendance</div>
            </div>
            <div>
                <div style="font-family:var(--font-display);font-size:2rem;font-weight:800;color:var(--muted);">@Model.ClassAveragePercent.ToString("0.#")%</div>
                <div style="color:var(--muted);font-size:0.85rem;">Class average</div>
            </div>
            <span class="badge" style="background:@(isAbove ? "#E4F7E6" : "#FFE7F0");color:@(isAbove ? "var(--grass-dark)" : "var(--bubblegum-dark)");font-size:0.85rem;">
                @(isAbove ? "+" : "")@diff.ToString("0.#") pts @(isAbove ? "above" : "below") average
            </span>
        </div>
        <div style="font-size:0.8rem;color:var(--muted);margin-bottom:4px;">You</div>
        <div style="background:var(--line);border-radius:999px;height:10px;overflow:hidden;">
            <div style="width:@(Model.MyOverallPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--grass);height:100%;border-radius:999px;"></div>
        </div>
        <div style="font-size:0.8rem;color:var(--muted);margin:10px 0 4px;">Class average</div>
        <div style="background:var(--line);border-radius:999px;height:10px;overflow:hidden;">
            <div style="width:@(Model.ClassAveragePercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--sky);height:100%;border-radius:999px;"></div>
        </div>
    </div>
}

<div class="card">
    <h1>My attendance</h1>

    <div style="display:flex;gap:12px;margin-bottom:20px;">
        <div class="card" style="flex:1;text-align:center;background:rgba(142,240,127,0.08);">
            <div style="font-family:var(--font-display);font-size:1.8rem;font-weight:800;color:var(--accent);">@Model.PresentCount</div>
            <div style="color:var(--muted);font-size:0.85rem;">Sessions attended</div>
        </div>
        <div class="card" style="flex:1;text-align:center;background:rgba(255,122,107,0.08);">
            <div style="font-family:var(--font-display);font-size:1.8rem;font-weight:800;color:var(--red);">@Model.AbsentCount</div>
            <div style="color:var(--muted);font-size:0.85rem;">Sessions missed</div>
        </div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <a class="btn secondary" href="?year=@(Model.Month == 1 ? Model.Year - 1 : Model.Year)&month=@(Model.Month == 1 ? 12 : Model.Month - 1)">‹ Prev</a>
        <strong>@(new DateOnly(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</strong>
        <a class="btn secondary" href="?year=@(Model.Month == 12 ? Model.Year + 1 : Model.Year)&month=@(Model.Month == 12 ? 1 : Model.Month + 1)">Next ›</a>
    </div>

    <div class="calendar-grid">
        @foreach (var day in Model.Days)
        {
            var isFuture = day.Date > DateOnly.FromDateTime(DateTime.Today);
            var cls = !day.HasSession ? "empty" : (isFuture ? "future" : (day.Present ? "present" : "absent"));
            var canQuery = day.HasSession && !isFuture && !day.Present && !day.QueryPending;

            if (canQuery)
            {
                <a class="cal-cell @cls" href="/Student/Query?sessionId=@day.SessionId" title="@day.MeetingTitle — click to query">@day.Date.Day</a>
            }
            else
            {
                <div class="cal-cell @cls" title="@(day.QueryPending ? day.MeetingTitle + " — query pending" : day.MeetingTitle)">
                    @day.Date.Day@(day.QueryPending ? "•" : "")
                </div>
            }
        }
    </div>

    <div class="legend">
        <span><span class="dot present"></span> Attended</span>
        <span><span class="dot absent"></span> Missed (click a missed day to query it)</span>
    </div>
</div>
