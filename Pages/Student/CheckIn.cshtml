@page
@model AttendanceApp.Pages.Student.CheckInModel
@{ ViewData["Title"] = "Check in"; }

<div class="card" style="max-width:460px;margin:0 auto;">
    <h1>Check in</h1>

    @if (Model.SuccessMessage is not null)
    {
        <div class="pill workshop" style="display:block;padding:12px;margin-bottom:16px;">@Model.SuccessMessage</div>
    }
    @if (!ModelState.IsValid)
    {
        <div class="pill test" style="display:block;padding:12px;margin-bottom:16px;" asp-validation-summary="All"></div>
    }

    <div id="qr-reader" style="margin-bottom:16px;"></div>
    <button type="button" class="btn secondary" id="scanBtn">Scan QR with camera</button>

    <form method="post" style="margin-top:20px;">
        <input type="hidden" id="scannedInput" name="Input.ScannedByCamera" value="false" />
        <div class="form-group">
            <label>Session code</label>
            <input asp-for="Input.Code" id="codeInput" required style="text-transform:uppercase;" />
        </div>
        <div class="form-group">
            <label>Student number</label>
            <input asp-for="Input.StudentNumber" required />
        </div>
        <button class="btn" type="submit">Confirm attendance</button>
    </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
<script src="~/js/checkin.js"></script>
