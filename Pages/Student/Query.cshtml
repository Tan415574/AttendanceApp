@page
@model AttendanceApp.Pages.Student.QueryModel
@{ ViewData["Title"] = "Query attendance"; }

<div class="card" style="max-width:460px;margin:0 auto;">
    <h1>Query this session</h1>
    <p style="color:#767b73;">
        @Model.Session?.Meeting?.Title — @Model.Session?.Date.ToString("d MMM yyyy")
    </p>

    <form method="post">
        <input type="hidden" asp-for="Input.SessionId" />
        <div class="form-group">
            <label>What happened?</label>
            <textarea asp-for="Input.Message" rows="4" placeholder="e.g. I was in the room but the code wasn't accepting scans"></textarea>
        </div>
        @if (!ModelState.IsValid)
        {
            <div style="color:#e8641c;" asp-validation-summary="All"></div>
        }
        <button class="btn" type="submit">Submit query</button>
    </form>
</div>
