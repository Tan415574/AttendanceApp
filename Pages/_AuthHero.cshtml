<div class="auth-hero">
    <div class="auth-hero-brand">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            <path d="M7.5 12.5L10.5 15.5L16.5 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        AttendanceApp
    </div>
    <p class="auth-hero-tagline">Real-time attendance tracking for lecturers and students — join codes, QR check-in, and live insight into who showed up.</p>

    <div class="auth-hero-visual">
        <div class="ring r1"></div>
        <div class="ring r2"></div>
        <div class="ring r3"></div>
        <div class="badge">
            <span class="dot"></span>
            <div>
                <div style="font-weight:700;">14 checked in</div>
                <div style="color:var(--muted);font-size:0.8rem;">Live session · Workshop 3</div>
            </div>
        </div>
    </div>

    <partial name="_Mascot" model='@(new MascotOptions { Shape = "circle", Size = 46, Color = "var(--sunny)", Face = "smile", Style = "position:absolute;top:64px;right:56px;z-index:1;" })' />
    <partial name="_Mascot" model='@(new MascotOptions { Shape = "blob", Size = 60, Color = "var(--sky)", Face = "wide", CssClass = "delay-1", Style = "position:absolute;bottom:150px;left:24px;z-index:1;" })' />
    <partial name="_Mascot" model='@(new MascotOptions { Shape = "square", Size = 34, Color = "var(--white)", Face = "smile", CssClass = "delay-2", Style = "position:absolute;bottom:150px;right:50px;z-index:1;opacity:0.85;" })' />

    <div class="auth-hero-float">
        <div class="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3L2 8L12 13L22 8L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M6 10.5V16C6 16 8.5 18.5 12 18.5C15.5 18.5 18 16 18 16V10.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div>
            <h3>Never chase a spreadsheet again</h3>
            <p>Scan a code, and attendance calculates itself — for every student, every session, automatically.</p>
        </div>
    </div>
</div>
