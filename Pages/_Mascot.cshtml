@model MascotOptions
@{
    var eyeInk = "#22201C";
}
<div class="mascot-decor @Model.CssClass" style="width:@(Model.Size)px;height:@(Model.Size)px;@Model.Style" aria-hidden="true">
    <svg viewBox="0 0 100 100" width="100%" height="100%">
        @if (Model.Shape == "square")
        {
            <rect x="8" y="8" width="84" height="84" rx="26" fill="@Model.Color" />
        }
        else if (Model.Shape == "blob")
        {
            <path d="M40 4C62 2 90 8 96 30C100 50 90 68 74 82C58 96 34 100 18 86C2 72 2 44 12 26C20 12 26 6 40 4Z" fill="@Model.Color" />
        }
        else
        {
            <ellipse cx="50" cy="52" rx="44" ry="42" fill="@Model.Color" />
        }
        @if (Model.Face == "wide")
        {
            <circle cx="35" cy="46" r="7" fill="@eyeInk" />
            <circle cx="65" cy="46" r="7" fill="@eyeInk" />
            <circle cx="50" cy="66" r="4" fill="@eyeInk" />
        }
        else
        {
            <circle cx="35" cy="46" r="4.5" fill="@eyeInk" />
            <circle cx="65" cy="46" r="4.5" fill="@eyeInk" />
            <path d="M32 62Q50 78 68 62" stroke="@eyeInk" stroke-width="4.5" fill="none" stroke-linecap="round" />
        }
    </svg>
</div>
