@page "{meetingId:int?}"
@model AttendanceApp.Pages.Lecturer.BoardModel
@{ ViewData["Title"] = Model.Meeting?.Title ?? "Board"; }

<div class="card">
    <div style="display:flex;align-items:center;gap:12px;">
        <partial name="_Mascot" model='@(new MascotOptions { Shape = "blob", Size = 40, Color = "var(--sky)", Face = "smile" })' />
        <h1 style="margin:0;">@Model.Meeting.Title <span class="pill @Model.Meeting.Type.ToString().ToLower()">@Model.Meeting.Type</span></h1>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Meeting.Description))
    {
        <p style="color:var(--muted);">@Model.Meeting.Description</p>
    }

    @if (!Model.TodaySession!.IsOpen)
    {
        <form method="post" asp-page-handler="Start">
            <input type="hidden" name="meetingId" value="@Model.Meeting.Id" />
            <button class="btn" type="submit">Start meeting</button>
        </form>
    }
    else
    {
        <div class="board-wrap">
            <div class="board-info">
                <div class="card hero-card">
                    <p style="margin:0;color:var(--hero-text-muted);">Join code</p>
                    <div class="join-code">@Model.TodaySession.JoinCode</div>
                    <div class="qr-box">
                        <img src="@Model.QrDataUrl" alt="QR code to check in" />
                    </div>
                    <p style="font-size:0.85rem;color:var(--hero-text-muted);">Scan, or go to /Student/CheckIn and enter the code</p>
                    <form method="post" asp-page-handler="Close" style="margin-top:12px;">
                        <input type="hidden" name="sessionId" value="@Model.TodaySession.Id" />
                        <button class="btn danger" type="submit">End meeting</button>
                    </form>
                </div>
            </div>

            <div class="board-canvas-holder" id="boardCanvas">
                <div class="board-count" id="checkedInCount">@Model.CheckedIn.Count checked in</div>
            </div>
        </div>

        <!-- matter.js: lightweight 2D physics engine, used only for the drop-in animation -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
        <script>
            window.BOARD_SESSION_ID = @Model.TodaySession.Id;
            window.INITIAL_CHECKINS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.CheckedIn.Select(c => new {
                    name = c.Student!.FullName,
                    number = c.Student.StudentNumber,
                    avatarIndex = c.Student.AvatarIndex
                })));
        </script>
        <script src="~/js/board.js"></script>
    }
</div>
