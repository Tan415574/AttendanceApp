@page
@model AttendanceApp.Pages.Lecturer.Meetings.CreateModel
@{ ViewData["Title"] = "New meeting"; }

<div class="card" style="max-width:520px;">
    <h1>New meeting</h1>
    <form method="post">
        <div class="form-group">
            <label>Heading</label>
            <input asp-for="Input.Title" placeholder="e.g. Databases Workshop 3" required />
        </div>
        <div class="form-group">
            <label>Description (optional)</label>
            <textarea asp-for="Input.Description" rows="2" placeholder="Short note for students"></textarea>
        </div>
        <div class="form-group">
            <label>Type</label>
            <select asp-for="Input.Type">
                <option value="Lecture">Lecture</option>
                <option value="Workshop">Workshop</option>
                <option value="Test">Test</option>
            </select>
        </div>
        <div class="form-group">
            <label>Recurrence</label>
            <select asp-for="Input.Recurrence" id="recurrenceSelect">
                <option value="OnceOff">Once-off</option>
                <option value="Weekly">Weekly</option>
            </select>
        </div>
        <div class="form-group">
            <label id="startLabel">Date</label>
            <input asp-for="Input.StartDate" type="date" required />
        </div>
        <div class="form-group" id="endDateGroup">
            <label>Repeat until</label>
            <input asp-for="Input.EndDate" type="date" />
        </div>
        <div class="form-group">
            <label>Time</label>
            <input asp-for="Input.TimeOfDay" type="time" required />
        </div>

        @if (!ModelState.IsValid)
        {
            <div style="color:#e8641c;" asp-validation-summary="All"></div>
        }

        <button class="btn" type="submit">Create meeting</button>
    </form>
</div>

<script>
    // Only show "repeat until" when Weekly is selected — keeps the once-off form uncluttered.
    const recurrence = document.getElementById('recurrenceSelect');
    const endGroup = document.getElementById('endDateGroup');
    function syncVisibility() {
        endGroup.style.display = recurrence.value === 'Weekly' ? 'block' : 'none';
    }
    recurrence.addEventListener('change', syncVisibility);
    syncVisibility();
</script>
