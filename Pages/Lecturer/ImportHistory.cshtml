@page
@model AttendanceApp.Pages.Lecturer.ImportHistoryModel
@{ ViewData["Title"] = "Import past attendance"; }

<div class="card" style="max-width:640px;">
    <h1>Import past attendance</h1>
    <p style="color:#767b73;font-size:0.9rem;">
        Bring in attendance you were tracking before you started using this app — one
        upload, covering every session and every student in the sheet. Expected format:
        a CSV file, one row per student. Column 1 is the student's name, column 2 their
        student number, and every column after that is one session date (e.g.
        <code>2026/03/02</code>) with <code>1</code> for present or <code>0</code> for
        absent in each cell. A student number that isn't registered yet gets a
        placeholder account so their attendance is worked out immediately — it becomes a
        normal account the first time they sign up with that same student number and log
        in to see it.
    </p>

    @if (Model.ErrorMessage is not null)
    {
        <p style="color:#e8641c;">@Model.ErrorMessage</p>
    }

    <form method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label>Course / module name</label>
            <input asp-for="Input.CourseTitle" placeholder="e.g. INF3003W" required />
        </div>
        <div class="form-group">
            <label>Type</label>
            <select asp-for="Input.Type">
                <option value="Lecture">Lecture</option>
                <option value="Workshop">Workshop</option>
                <option value="Test">Test</option>
            </select>
        </div>
        <div class="form-group">
            <label>CSV file</label>
            <input type="file" asp-for="Input.UploadFile" accept=".csv,.txt" required />
        </div>
        <button class="btn" type="submit">Import</button>
    </form>

    @if (Model.Result is { } r)
    {
        <div class="card" style="background:#fafaf7;margin-top:20px;">
            <h2 style="margin-top:0;">Import results</h2>
            <ul>
                <li>@r.SessionsCreated session(s) created — one per date column in the sheet</li>
                <li>@r.RecordsMarkedPresent cell(s) marked present</li>
                <li>@r.RecordsMarkedAbsent existing record(s) cleared back to absent</li>
                <li>@r.PlaceholderAccountsCreated placeholder student account(s) created for unregistered student numbers</li>
                <li>@r.InvalidCells cell(s) skipped — value wasn't <code>1</code> or <code>0</code></li>
                <li>@r.ConflictsSkipped cell(s) left untouched — student has an open query on that session</li>
            </ul>
            <p>Every student's attendance has already been worked out from these records —
               <a href="/Lecturer/Meetings/Index">view it under "My meetings"</a>, or students
               can sign in and see their own calendar right away.</p>

            @if (r.Messages.Any())
            {
                <p style="color:#767b73;font-size:0.85rem;">Details:</p>
                <ul style="font-size:0.85rem;color:#767b73;">
                    @foreach (var msg in r.Messages)
                    {
                        <li>@msg</li>
                    }
                </ul>
            }
        </div>
    }
</div>
