@page
@model AttendanceApp.Pages.Lecturer.QueriesModel
@{ ViewData["Title"] = "Attendance queries"; }

<div class="card">
    <div style="display:flex;align-items:center;gap:12px;">
        <partial name="_Mascot" model='@(new MascotOptions { Shape = "square", Size = 40, Color = "var(--bubblegum)", Face = "wide" })' />
        <h1 style="margin:0;">Open queries</h1>
    </div>

    @if (!Model.OpenQueries.Any())
    {
        <div class="mascot-empty-state">
            <partial name="_Mascot" model='@(new MascotOptions { Shape = "circle", Size = 88, Color = "var(--grass)", Face = "smile" })' />
        </div>
        <p style="text-align:center;">No open queries right now.</p>
    }

    @foreach (var q in Model.OpenQueries)
    {
        <div class="card" style="background:#E3F1FF;">
            <strong>@q.Student!.FullName</strong> (@q.Student.StudentNumber)
            — @q.MeetingSession!.Meeting!.Title, @q.MeetingSession.Date.ToString("d MMM yyyy")
            <p style="color:var(--muted);">"@q.QueryMessage"</p>

            <form method="post" asp-page-handler="Accept" style="display:inline-block;margin-right:8px;">
                <input type="hidden" name="recordId" value="@q.Id" />
                <input type="text" name="response" placeholder="Optional note to student" style="padding:8px 12px;border-radius:10px;border:2px solid var(--card-border);margin-right:6px;background:var(--white);color:var(--text);" />
                <button class="btn" type="submit">Mark present</button>
            </form>
            <form method="post" asp-page-handler="Reject" style="display:inline-block;">
                <input type="hidden" name="recordId" value="@q.Id" />
                <button class="btn secondary" type="submit">Keep as absent</button>
            </form>
        </div>
    }
</div>
