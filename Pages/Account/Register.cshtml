@page
@model AttendanceApp.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Sign up";
    ViewData["HideTopbar"] = true;
}

<div class="auth-split">
    <partial name="_AuthHero" />

    <div class="auth-form-panel">
        <div class="card">
            <h1>Create an Account</h1>
            <p class="auth-form-subtitle">Register to access your dashboard.</p>
            <form method="post">
                <div class="form-group">
                    <label>I am a...</label>
                    <div class="role-toggle">
                        <button type="button" class="role-option active" data-role="Student">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 3L2 8L12 13L22 8L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M6 10.5V16C6 16 8.5 18.5 12 18.5C15.5 18.5 18 16 18 16V10.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Student
                        </button>
                        <button type="button" class="role-option" data-role="Lecturer">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="2"/>
                                <path d="M8 7V5C8 3.89543 8.89543 3 10 3H14C15.1046 3 16 3.89543 16 5V7" stroke="currentColor" stroke-width="2"/>
                                <path d="M3 12H21" stroke="currentColor" stroke-width="2"/>
                            </svg>
                            Lecturer
                        </button>
                    </div>
                    <select asp-for="Input.Role" id="roleSelect" style="display:none;">
                        <option value="Student">Student</option>
                        <option value="Lecturer">Lecturer</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Full Name</label>
                    <div class="input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/>
                            <path d="M4 20C4 16.6863 7.58172 14 12 14C16.4183 14 20 16.6863 20 20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <input asp-for="Input.FullName" placeholder="Jane Doe" required />
                    </div>
                </div>

                <div class="form-group" id="studentNumberGroup">
                    <label>Student Number</label>
                    <div class="input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/>
                            <path d="M7 9H17M7 13H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <input asp-for="Input.StudentNumber" placeholder="e.g. STDNUM021" />
                    </div>
                </div>

                <div class="form-group">
                    <label>University Email</label>
                    <div class="input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/>
                            <path d="M3 7L12 13L21 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <input asp-for="Input.Email" type="email" placeholder="jane.doe@university.edu" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="2"/>
                            <path d="M8 11V7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7V11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <input asp-for="Input.Password" type="password" placeholder="••••••••" required />
                    </div>
                </div>

                @if (!ModelState.IsValid)
                {
                    <div class="pill test" style="display:block;margin-bottom:16px;" asp-validation-summary="All"></div>
                }

                <button class="btn" type="submit" style="width:100%;">Register Now &rarr;</button>
            </form>
            <p class="auth-switch">Already have an account? <a href="/Account/Login">Back to Sign In</a></p>
        </div>
    </div>
</div>

<script>
    const roleOptions = document.querySelectorAll('.role-option');
    const roleSelect = document.getElementById('roleSelect');
    const studentNumberGroup = document.getElementById('studentNumberGroup');

    function syncRole(role) {
        roleOptions.forEach(btn => btn.classList.toggle('active', btn.dataset.role === role));
        roleSelect.value = role;
        studentNumberGroup.style.display = role === 'Student' ? 'block' : 'none';
    }

    roleOptions.forEach(btn => btn.addEventListener('click', () => syncRole(btn.dataset.role)));
    syncRole(roleSelect.value || 'Student');
</script>
