@page
@model AttendanceApp.Pages.Account.LoginModel
@{ ViewData["Title"] = "Sign in"; }

<div class="card" style="max-width:400px;margin:0 auto;">
    <h1>Sign in</h1>
    <form method="post">
        <div class="form-group">
            <label>Email</label>
            <input asp-for="Input.Email" type="email" required />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input asp-for="Input.Password" type="password" required />
        </div>

        @if (!ModelState.IsValid)
        {
            <div style="color:var(--red);" asp-validation-summary="All"></div>
        }

        <button class="btn" type="submit">Sign in</button>
    </form>
    <p style="margin-top:16px;font-size:0.9rem;">No account? <a href="/Account/Register">Sign up</a></p>
</div>
