@page
@model AttendanceApp.Pages.IndexModel
@{
    ViewData["Title"] = "AttendanceApp — Attendance that runs itself";
    ViewData["HideTopbar"] = true;
}

<div class="page-full">
    <header class="landing-header">
        <a class="auth-hero-brand" href="/">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                <path d="M7.5 12.5L10.5 15.5L16.5 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            AttendanceApp
        </a>
        <nav style="display:flex;gap:12px;">
            <a class="btn secondary" href="/Account/Login">Sign in</a>
            <a class="btn" href="/Account/Register">Get started</a>
        </nav>
    </header>

    <section class="landing-hero">
        <div class="landing-hero-text">
            <span class="landing-kicker">Real-time attendance</span>
            <h1>Attendance that<br />runs itself.</h1>
            <p>
                Lecturers open a session and get a join code + QR instantly. Students scan
                or type a code. Attendance calculates itself — for every student, every
                session — with a live board that shows who just checked in, in real time.
            </p>
            <div class="landing-cta-row">
                <a class="btn" href="/Account/Register">Get started free &rarr;</a>
                <a class="btn secondary" href="/Account/Login">Sign in</a>
            </div>
        </div>
        <div class="landing-demo">
            <div class="board-canvas-holder" id="landingCanvas">
                <div class="board-count" id="landingCount">0 checked in</div>
            </div>
            <p class="landing-demo-caption">This is the actual live check-in board — students drop in as animated avatars the moment they scan.</p>
        </div>
    </section>

    <section class="landing-section">
        <h2>Everything you need to run attendance</h2>
        <p class="landing-section-sub">Built for lecturers and students, not spreadsheets.</p>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon" style="background:#E4F7E6;color:var(--grass-dark);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><path d="M14 14H21V21H14V14Z" stroke="currentColor" stroke-width="2"/></svg>
                </div>
                <h3>QR + join code check-in</h3>
                <p>Students scan a QR or type a short code — cross-checked against their signed-in account so nobody can check in as someone else.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#FFE9E2;color:var(--coral-dark);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7V12L15 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <h3>Live physics check-in board</h3>
                <p>Every check-in drops onto the board in real time via SignalR — a fun, at-a-glance view of the room filling up.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#E3F1FF;color:var(--sky-dark);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 10H21" stroke="currentColor" stroke-width="2"/><path d="M8 3V7M16 3V7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <h3>Calendar &amp; disputes</h3>
                <p>Students see a green/red calendar of every session and can query a day they think is wrong — lecturers resolve it in one click.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#FFF3D0;color:var(--sunny-dark);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 17L9 11L13 15L21 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 7H21V13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h3>Lecturer analytics dashboard</h3>
                <p>Class-wide trends, an at-risk student list, and attendance broken down by session type and day of week — no spreadsheet required.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#FFE7F0;color:var(--bubblegum-dark);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3V15M12 15L8 11M12 15L16 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 15V18C4 19.1046 4.89543 20 6 20H18C19.1046 20 20 19.1046 20 18V15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <h3>Bring in your old spreadsheet</h3>
                <p>One CSV upload works out every student's attendance across every past session automatically — even for students who haven't signed up yet.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#E4F7E6;color:var(--grass-dark);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
                </div>
                <h3>See yourself vs. the class</h3>
                <p>Students get their own overall attendance compared against the class average — no waiting for an end-of-term report.</p>
            </div>
        </div>
    </section>

    <section class="landing-section landing-how">
        <h2>How it works</h2>
        <div class="how-steps">
            <div class="how-step">
                <div class="how-num">1</div>
                <h3>Start a session</h3>
                <p>A lecturer opens a meeting and gets a fresh join code + QR instantly.</p>
            </div>
            <div class="how-step">
                <div class="how-num">2</div>
                <h3>Students check in</h3>
                <p>Scan the code or type it — verified against their own account.</p>
            </div>
            <div class="how-step">
                <div class="how-num">3</div>
                <h3>It calculates itself</h3>
                <p>Attendance, trends, and at-risk alerts update live — for everyone.</p>
            </div>
        </div>
    </section>

    <section class="landing-final-cta">
        <h2>Stop chasing spreadsheets.</h2>
        <p>Set up your first session in under a minute.</p>
        <a class="btn" href="/Account/Register">Get started free &rarr;</a>
    </section>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
<script src="~/js/landing-demo.js"></script>
